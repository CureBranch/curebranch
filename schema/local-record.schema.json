{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:curebranch:schema:local-record:0.1",
  "title": "CureBranch private local record",
  "description": "Everything the patient has, kept ONLY on their own device (browser IndexedDB, or a file they download). Never uploaded by CureBranch. Raw records are stored as standard FHIR R4 Bundles so any FHIR tool can read them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "code",
    "created",
    "updated",
    "privacy",
    "afterDeath",
    "sources",
    "share"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "code": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{6,12}$",
      "description": "Same random code as the public summary."
    },
    "example": {
      "type": "boolean"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public"
      ],
      "properties": {
        "public": {
          "type": "boolean",
          "description": "The one switch. false = nothing is published (default)."
        }
      }
    },
    "afterDeath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice"
      ],
      "properties": {
        "choice": {
          "enum": [
            "keep-private",
            "remove",
            "keep-public",
            "person-decides"
          ],
          "description": "keep-private: nothing is ever published. remove: ask for the public summary to be deleted. keep-public: make (or keep) the summary public. person-decides: the named person decides."
        },
        "person": {
          "description": "The person the patient named to carry out the choice. Stays on this device only; never published.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 120
            },
            "howToReach": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "stewardKeyHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stewardKeyGivenOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "importedAt",
          "verification",
          "bundle"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fhir-bundle-file",
              "smart-health-card",
              "smart-on-fhir"
            ]
          },
          "fileName": {
            "type": "string"
          },
          "importedAt": {
            "type": "string",
            "format": "date-time"
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "method"
            ],
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "unverified"
                ]
              },
              "method": {
                "enum": [
                  "smart-health-card",
                  "smart-on-fhir",
                  "file-upload",
                  "self-reported"
                ]
              },
              "issuer": {
                "type": "string"
              },
              "detail": {
                "type": "string",
                "description": "Plain-English reason for the status, e.g. 'Signature checked against issuer key'."
              }
            }
          },
          "bundle": {
            "description": "The raw FHIR R4 Bundle exactly as imported.",
            "type": "object",
            "required": [
              "resourceType"
            ],
            "properties": {
              "resourceType": {
                "const": "Bundle"
              }
            }
          },
          "example": {
            "type": "boolean",
            "description": "true if this source is made-up EXAMPLE data."
          },
          "origin": {
            "description": "Where the record came from, in the patient's words: which portal and how it was connected. 'demo-stub' = made-up EXAMPLE records from the stand-in connection.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "connectedVia"
            ],
            "properties": {
              "connectedVia": {
                "enum": [
                  "smart-on-fhir",
                  "smart-health-card",
                  "file-upload",
                  "demo-stub"
                ]
              },
              "portal": {
                "enum": [
                  "mychart",
                  "oracle-health",
                  "apple-health",
                  "other"
                ]
              },
              "portalName": {
                "type": "string",
                "maxLength": 120
              },
              "fhirServer": {
                "type": "string",
                "format": "uri",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "share": {
      "description": "Which parts of the summary the patient chose to publish. The patient decides each one.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cancerType": {
          "type": "boolean"
        },
        "stageGroup": {
          "type": "boolean"
        },
        "ageBand": {
          "type": "boolean"
        },
        "markers": {
          "type": "boolean"
        },
        "treatments": {
          "type": "boolean"
        },
        "outcomes": {
          "type": "boolean"
        },
        "publicContact": {
          "type": "boolean"
        },
        "profile": {
          "type": "boolean",
          "description": "Show display name/photo on the public profile page. Default false (anonymous)."
        }
      }
    },
    "branchPath": {
      "description": "Branch path the patient set or approved. If absent, the app suggests one from the records.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "branchPlacedBy": {
      "enum": [
        "rules",
        "patient",
        "patient-ai"
      ]
    },
    "publicContact": {
      "type": "string",
      "maxLength": 100
    },
    "ai": {
      "description": "Which AI the patient uses. The patient pays for and runs their own AI; CureBranch stores no API keys.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 60
        }
      }
    },
    "editLog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "what"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "profile": {
      "description": "Optional profile. Stays private unless share.profile is true AND privacy.public is true.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 60
        },
        "photo": {
          "$ref": "urn:curebranch:schema:public-summary:0.1#/properties/profile/properties/photo"
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "description": "Opt-in web push. Off by default.",
      "properties": {
        "pushOptIn": {
          "type": "boolean"
        }
      }
    },
    "files": {
      "description": "Supporting photos and files from the patient (for example a photo of a paper report). Allowed ONLY when linked to an official imported record (linkedSourceId), and always labeled 'supporting, from patient'. Only this metadata is in the record; the bytes are kept in a separate entry in the same on-device store. Never uploaded, never in the public summary, never counted in the tree.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "linkedSourceId",
          "role",
          "name",
          "mediaType",
          "size",
          "kind",
          "addedAt",
          "matchStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "linkedSourceId": {
            "type": "string",
            "description": "id of the official (verified) source this file supports."
          },
          "role": {
            "const": "supporting-from-patient"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "mediaType": {
            "type": "string",
            "maxLength": 100
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "photo",
              "document"
            ]
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "verification": {
            "const": "unverified"
          },
          "claims": {
            "description": "What the patient says the photo or file shows. Checked against the linked official record.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "testType": {
                "type": "string",
                "maxLength": 120
              },
              "keyValues": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            }
          },
          "matchStatus": {
            "enum": [
              "matches",
              "mismatch",
              "unchecked"
            ],
            "description": "Result of comparing claims with the linked official record (app/js/consistency.js). unchecked = nothing entered yet."
          },
          "mismatchReasons": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            },
            "description": "Plain-English reasons shown to the patient when matchStatus is mismatch."
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ignoreForAiMatching": {
            "type": "boolean",
            "description": "true when matchStatus is mismatch: AI matching must not use this file."
          }
        }
      }
    },
    "onboarding": {
      "description": "Progress and answers from the first-run setup guide, so the patient can stop and pick up later, or run it again from Settings. Stays on this device.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "step"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "step": {
          "enum": [
            "welcome",
            "profile",
            "records",
            "privacy",
            "after",
            "ai",
            "done"
          ],
          "description": "The step to reopen at."
        },
        "stepsDone": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "welcome",
              "profile",
              "records",
              "privacy",
              "after",
              "ai",
              "done"
            ]
          }
        },
        "skipped": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "records",
              "ai"
            ]
          }
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "watchedAndUnderstood",
            "at"
          ],
          "properties": {
            "watchedAndUnderstood": {
              "const": true,
              "description": "The patient ticked 'I watched and understand' on the welcome step."
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "videoVersion": {
              "type": "string",
              "maxLength": 60,
              "description": "Which consent video they saw ('placeholder' until a real one exists)."
            }
          }
        },
        "afterDeathChosen": {
          "type": "boolean",
          "description": "true once the patient picked an after-death choice themselves (the starting value is not a choice)."
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "restartedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "portal": {
          "enum": [
            "mychart",
            "oracle-health",
            "apple-health",
            "other"
          ],
          "description": "The portal the patient picked on the 'Connect your hospital portal' step."
        }
      }
    }
  }
}
